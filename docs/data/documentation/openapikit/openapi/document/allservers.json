 servers not found in the"},{"type":"text","text":" "},{"type":"text","text":"root servers array."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"servers","type":"codeVoice"},{"text":" property on ","type":"text"},{"code":"OpenAPI.Document","type":"codeVoice"},{"text":", by contrast, contains","type":"text"},{"text":" ","type":"text"},{"text":"servers that are applicable to all paths and operations that","type":"text"},{"text":" ","type":"text"},{"text":"do not define their own ","type":"text"},{"code":"serves","type":"codeVoice"},{"text":" array to override the root array.","type":"text"}]},{"type":"aside","name":"Important","content":[{"inlineContent":[{"text":"For the purposes of returning one of each ","type":"text"},{"code":"Server","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"two servers are considered identical if they have the same ","type":"text"},{"code":"url","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"variables","type":"codeVoice"},{"text":". Differing ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" properties for","type":"text"},{"text":" ","type":"text"},{"text":"otherwise identical servers are considered to be two ways to","type":"text"},{"text":" ","type":"text"},{"text":"describe the same server. ","type":"text"},{"code":"vendorExtensions","type":"codeVoice"},{"text":" are also","type":"text"},{"text":" ","type":"text"},{"text":"ignored when determining server uniqueness.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The first "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" encountered will be used, so if the only"},{"type":"text","text":" "},{"type":"text","text":"difference between a server at the root document level and"},{"type":"text","text":" "},{"type":"text","text":"one in an "},{"type":"codeVoice","code":"Operation"},{"type":"text","text":"’s override of the servers array is the"},{"type":"text","text":" "},{"type":"text","text":"description, the description of the "},{"type":"codeVoice","code":"Server"},{"type":"text","text":" returned by this"},{"type":"text","text":" "},{"type":"text","text":"property will be that of the root document definition."}],"type":"paragraph"}],"style":"important"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"All servers referenced anywhere in the whole document.","type":"text"}],"variants":[{"paths":["\/documentation\/openapikit\/openapi\/document\/allservers"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document":{"abstract":[{"type":"text","text":"The root of an OpenAPI 3.1 document."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Document"}],"type":"topic","title":"OpenAPI.Document","url":"\/documentation\/openapikit\/openapi\/document","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Document"}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Server":{"title":"OpenAPI.Server","identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Server","navigatorTitle":[{"kind":"identifier","text":"Server"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Server"}],"url":"\/documentation\/openapikit\/openapi\/server","type":"topic","abstract":[{"type":"text","text":"OpenAPI Spec “Server Object”"}],"role":"symbol","kind":"symbol"},"doc://OpenAPIKit/documentation/OpenAPIKit/OpenAPI/Document/allServers":{"url":"\/documentation\/openapikit\/openapi\/document\/allservers","abstract":[{"type":"text","text":"All servers referenced anywhere in the whole document."}],"identifier":"doc:\/\/OpenAPIKit\/documentation\/OpenAPIKit\/OpenAPI\/Document\/allServers","title":"allServers","type":